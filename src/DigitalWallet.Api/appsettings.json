{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Platform": {
    "BusinessTimeZone": "Asia/Riyadh",
    "PostgreSql": {
      "ConnectionString": "",
      "DefaultSchema": "platform"
    }
  },
  "Identity": {
    "Jwt": {
      "Issuer": "DigitalWallet",
      "Audience": "DigitalWallet.Api",
      "SigningKey": "",
      "AccessTokenLifetimeMinutes": 10,
      "RefreshTokenLifetimeDays": 30
    },
    "Otp": {
      "HashKey": "",
      "LifetimeMinutes": 10,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxResends": 3
    },
    "TokenHashKey": ""
  },
  "AllowedHosts": "",
  "Messaging": {
    "WorkersEnabled": true,
    "RabbitUri": "",
    "Prefix": "digitalwallet.v1",
    "LeaseSeconds": 60,
    "PublishTimeoutSeconds": 15,
    "RetryBaseMilliseconds": 1000,
    "MaxConsumerAttempts": 3,
    "PollMilliseconds": 500
  },
  "Caching": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "Environment": "development",
    "KeySecret": "",
    "OperationTimeoutMilliseconds": 200,
    "BackoffMilliseconds": 2000,
    "MaxPayloadBytes": 16384,
    "PermissionTtlSeconds": 30,
    "SettingsTtlSeconds": 30,
    "DashboardTtlSeconds": 5,
    "JitterRatio": 0.2
  },
  "HttpSecurity": {
    "AdminOrigins": [],
    "KnownProxies": [],
    "MaxRequestBodyBytes": 65536,
    "HeaderTimeoutSeconds": 10,
    "ExternalWorkersDecision": ""
  },
  "Observability": {
    "ExportEnabled": false,
    "Endpoint": "",
    "SampleRatio": 1.0,
    "QueueCapacity": 2048,
    "ExportTimeoutMilliseconds": 500,
    "MetricIntervalMilliseconds": 10000,
    "ReconciliationEnabled": true,
    "ReconciliationIntervalSeconds": 300,
    "ReconciliationTimeoutSeconds": 120
  }
}
