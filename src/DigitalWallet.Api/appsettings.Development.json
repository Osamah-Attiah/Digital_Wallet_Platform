{
  "Messaging": {
    "WorkersEnabled": false,
    "RabbitUri": "amqp://guest:guest@localhost:5672/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Identity": {
    "Jwt": {
      "Issuer": "DigitalWallet",
      "Audience": "DigitalWallet.Api",
      "SigningKey": "development-only-not-a-secret-change-through-user-secrets-or-environment-32-bytes",
      "AccessTokenLifetimeMinutes": 10,
      "RefreshTokenLifetimeDays": 30
    },
    "Otp": {
      "HashKey": "development-only-otp-hash-key-change-through-user-secrets-or-environment",
      "LifetimeMinutes": 10,
      "MaxAttempts": 5,
      "ResendCooldownSeconds": 60,
      "MaxResends": 3
    },
    "TokenHashKey": "development-only-token-hash-key-change-through-user-secrets-or-environment"
  },
  "Platform": {
    "PostgreSql": {
      "ConnectionString": "Host=localhost;Port=5432;Database=digital_wallet;Username=postgres"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "HttpSecurity": {
    "AdminOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  }
}
