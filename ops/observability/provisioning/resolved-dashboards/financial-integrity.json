{
  "uid": "wallet-financial-integrity",
  "title": "Digital Wallet \u00b7 Financial Integrity",
  "description": "Operational measurements. Missing data is unknown. Inspect labeled values and the data table; no formal production SLO. All times UTC.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "digitalwallet",
    "phase12"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Ledger imbalance \u2014 critical above zero",
      "description": "Count of unbalanced committed journals. Expected zero; any positive value requires investigation.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(wallet_ledger_imbalance)",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Projection drift \u2014 critical above zero",
      "description": "Accounts whose projection differs from immutable entries. Expected zero; do not repair automatically.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(wallet_ledger_projection_drift)",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Reconciliation freshness (seconds)",
      "description": "Age of the most recent successful read-only reconciliation. A finding still counts as a completed read.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(wallet_reconciliation_last_success)",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Posting failures / 5 minutes",
      "description": "Technical posting failures; business validation rejections are shown separately.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(wallet_operation_count{module=\"Ledger\",operation=\"Post\",outcome=\"Failed\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Transfer confirmation outcomes / second",
      "description": "Attempts including idempotent replay; Completed counts calls returning committed completion, not unique transfers.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(wallet_operation_count{module=\"Transfers\",operation=\"Confirm\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Reversal operations / second",
      "description": "Request, approval and rejection API operation outcomes. Replay is counted as a call.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(wallet_operation_count{module=\"Transactions\",operation=~\"Reversal.*\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Ledger posting p95",
      "description": "Owner posting duration, including validation and lock wait; does not imply a production SLO.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "wallet-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wallet_operation_duration_bucket{module=\"Ledger\",operation=\"Post\"}[5m])))",
          "legendFormat": "{{operation}} {{outcome}} {{event}} {{consumer}} {{status_family}} {{route}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "noValue": "No data \u2014 verify exporter and collection",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "textMode": "value_and_name",
        "colorMode": "none"
      }
    }
  ],
